+		// Copies the existing radar layers for a second display. Must run on the engine thread.
+		public (int[] Pixels, int Width, int Height, bool Available, float[] Viewport) ExportThorRadar()
+		{
+			if (terrainSprite == null || radarData == null)
+				return ([], 0, 0, false, []);
+			var bounds = terrainSprite.Bounds;
+			var pixels = new int[bounds.Width * bounds.Height];
+			var stride = radarSheet.Size.Width;
+			if (hasRadar)
+				unsafe
+				{
+					fixed (byte* bytes = radarData)
+					{
+						var colors = (uint*)bytes;
+						for (var y = 0; y < bounds.Height; y++)
+							for (var x = 0; x < bounds.Width; x++)
+							{
+								var offset = (bounds.Top + y) * stride + bounds.Left + x;
+								var color = colors[offset];
+								var actor = colors[offset + previewHeight * stride];
+								if ((actor >> 24) != 0) color = actor;
+								var fog = (int)(colors[offset + previewWidth] >> 24);
+								var light = 255 - fog;
+								pixels[y * bounds.Width + x] = unchecked((int)(0xff000000u |
+									(uint)(((color >> 16) & 255) * light / 255) << 16 |
+									(uint)(((color >> 8) & 255) * light / 255) << 8 |
+									(uint)((color & 255) * light / 255)));
+							}
+					}
+				}
+			var tl = world.Map.CellContaining(worldRenderer.ProjectedPosition(worldRenderer.Viewport.TopLeft)).ToMPos(world.Map);
+			var br = world.Map.CellContaining(worldRenderer.ProjectedPosition(worldRenderer.Viewport.BottomRight)).ToMPos(world.Map);
+			return (pixels, bounds.Width, bounds.Height, hasRadar, [
+				(tl.U * cellWidth - bounds.Left) / (float)bounds.Width, (tl.V - bounds.Top) / (float)bounds.Height,
+				(br.U * cellWidth - bounds.Left) / (float)bounds.Width, (br.V - bounds.Top) / (float)bounds.Height]);
+		}
+
+		public void TargetThorRadar(float x, float y, bool issueOrders)
+		{
+			if (!hasRadar || terrainSprite == null) return;
+			var b = terrainSprite.Bounds;
+			var cell = world.Map.Clamp(new MPos((int)((b.Left + x.Clamp(0, 1) * (b.Width - 1)) / cellWidth),
+				(int)(b.Top + y.Clamp(0, 1) * (b.Height - 1))).ToCPos(world.Map));
+			var position = world.Map.CenterOfCell(cell);
+			if (!issueOrders) { worldRenderer.Viewport.Center(position); return; }
+			var pixel = worldRenderer.ScreenPxPosition(position);
+			var input = new MouseInput(MouseInputEvent.Down, Game.Settings.Game.MouseButtonPreference.Action,
+				worldRenderer.Viewport.WorldToViewPx(pixel), int2.Zero, Modifiers.None, 1);
+			foreach (var order in world.OrderGenerator.Order(world, cell, pixel, input)) world.IssueOrder(order);
+		}
