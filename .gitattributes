# Enforce LF normalization on Windows
*.yaml eol=lf
*.lua eol=lf
* text=auto
*.sh eol=lf
*.py eol=lf
*.yml eol=lf
*.json eol=lf
*.md eol=lf
patches/*.patch -whitespace eol=lf
*.png binary
*.ico binary
*.icns binary

# Custom for Visual Studio
*.cs     diff=csharp
*.sln    merge=union
*.csproj merge=union
*.vbproj merge=union
*.fsproj merge=union
*.dbproj merge=union
